diff --git a/backend/src/main/java/com/vinabeef/web/ReaderReadFeed.java b/backend/src/main/java/com/vinabeef/web/ReaderReadFeed.java
new file mode 100644
index 0000000..3b11830
--- /dev/null
+++ b/backend/src/main/java/com/vinabeef/web/ReaderReadFeed.java
@@ -0,0 +1,85 @@
+package com.vinabeef.web;
+
+/**
+ * The recent reads of one gate's readers for the reader page, each with what became of it.
+ *
+ * <p>A read is not simply "a passage or an alert". The reads of a gate with an inner and an outer reader end in one of:
+ * <ul>
+ *   <li>{@code PASSAGE}: the read that completed a crossing (it is the movement's source event)</li>
+ *   <li>{@code CROSSING_FIRST}: the earlier read of a crossing that completed; it is counted with the passage</li>
+ *   <li>{@code HALF_CROSSING}: the tag is registered, but the other reader has not seen it (yet). It waits as an
+ *       unpaired sighting. {@code half_side} says which reader saw it and {@code other_delta_ms} how far away the
+ *       nearest sighting of the other reader is (positive: later), so a slow crossing is visible as such</li>
+ *   <li>{@code NO_MOVEMENT}: the tag is registered but the read made no movement, for example a repeat read while the
+ *       animal walks away from the reader, or an unpaired sighting that is older than the retention time</li>
+ *   <li>{@code UNREGISTERED_TAG}: no animal is bound to the tag (an alert was raised)</li>
+ *   <li>{@code COPY}: the second copy of a tap that came by both routes (Safetrust and the USB reader)</li>
+ *   <li>{@code USB_UNMAPPED}: a USB read whose credential number matches no card</li>
+ *   <li>{@code SYSTEM}: heartbeat, status or telemetry event of the reader</li>
+ * </ul>
+ *
+ * <p>The animal is found the way the processing service finds it: the tag's assignment that was active when the read
+ * was handled, else the event's user name when that is a live animal.
+ *
+ * <p>The newest {@value #LIMIT} reads are taken first and only those are joined, so the page stays cheap on a reader
+ * with a long history. Parameters: the gate id, twice.
+ */
+final class ReaderReadFeed {
+
+    static final int LIMIT = 50;
+
+    static final String SQL = """
+        WITH recent AS (
+            SELECT re.event_id, re.event_key, re.reader_name, re.card_uuid, re.user_name, re.gate_action,
+                   re.observed_at, COALESCE(re.received_at, re.observed_at) AS handled_at,
+                   re.event_class, re.read_source, re.source_device, re.credential_identifier, re.duplicate_of
+            FROM rfid_read_events re
+            WHERE re.reader_name IN (SELECT g.reader_name FROM gates g WHERE g.gate_id = ?
+                                     UNION SELECT gr.reader_name FROM gate_readers gr WHERE gr.gate_id = ?)
+            ORDER BY re.observed_at DESC, re.event_id
+            LIMIT 50
+        )
+        SELECT r.event_id, r.event_key, r.reader_name, r.card_uuid, r.user_name, r.gate_action, r.observed_at,
+               r.event_class, r.read_source, r.source_device, r.credential_identifier, r.duplicate_of,
+               m.movement_id,
+               COALESCE(m.animal_id, fm.animal_id, ra.animal_id) AS animal_id,
+               COALESCE(m.direction, fm.direction)               AS direction,
+               CASE
+                   WHEN r.duplicate_of IS NOT NULL          THEN 'COPY'
+                   WHEN r.event_class = 'LOCAL_UNMAPPED'    THEN 'USB_UNMAPPED'
+                   WHEN m.movement_id  IS NOT NULL          THEN 'PASSAGE'
+                   WHEN fm.movement_id IS NOT NULL          THEN 'CROSSING_FIRST'
+                   WHEN cand.event_id  IS NOT NULL          THEN 'HALF_CROSSING'
+                   WHEN r.card_uuid IS NULL                 THEN 'SYSTEM'
+                   WHEN ra.animal_id IS NULL                THEN 'UNREGISTERED_TAG'
+                   ELSE 'NO_MOVEMENT'
+               END AS outcome,
+               cand.side AS half_side,
+               (SELECT c2.seen_ms - cand.seen_ms
+                  FROM gate_crossing_candidates c2
+                 WHERE c2.gate_id = cand.gate_id AND c2.tag_epc = cand.tag_epc AND c2.side <> cand.side
+                 ORDER BY ABS(c2.seen_ms - cand.seen_ms), c2.event_id
+                 LIMIT 1) AS other_delta_ms
+        FROM recent r
+        LEFT JOIN movements m  ON m.source_event_id = r.event_id
+        LEFT JOIN movements fm ON fm.first_event_id = r.event_id
+        LEFT JOIN gate_crossing_candidates cand ON cand.event_id = r.event_id
+        LEFT JOIN LATERAL (
+            SELECT COALESCE(
+                (SELECT ta.animal_id
+                   FROM tag_assignments ta
+                   JOIN rfid_tags t ON t.tag_id = ta.tag_id
+                  WHERE t.epc_value = r.card_uuid
+                    AND ta.valid_from <= r.handled_at
+                    AND (ta.valid_to IS NULL OR ta.valid_to > r.handled_at)
+                  ORDER BY ta.valid_from DESC
+                  LIMIT 1),
+                (SELECT a.animal_id FROM animals a
+                  WHERE a.animal_id = r.user_name AND a.lifecycle_status <> 'ARCHIVED')
+            ) AS animal_id
+        ) ra ON TRUE
+        ORDER BY r.observed_at DESC, r.event_id
+        """;
+
+    private ReaderReadFeed() { }
+}
diff --git a/backend/src/test/java/com/vinabeef/web/GatePairingSettingsTest.java b/backend/src/test/java/com/vinabeef/web/GatePairingSettingsTest.java
new file mode 100644
index 0000000..7f693be
--- /dev/null
+++ b/backend/src/test/java/com/vinabeef/web/GatePairingSettingsTest.java
@@ -0,0 +1,84 @@
+package com.vinabeef.web;
+
+import com.vinabeef.web.GatePairingSettings.Result;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/** The limits on a gate's pairing window and repeat-read time. */
+class GatePairingSettingsTest {
+
+    @Test
+    void leftOutValuesKeepTheCurrentSettings() {
+        Result r = GatePairingSettings.resolve(15_000, 3_000, null, null);
+        assertTrue(r.ok());
+        assertEquals(15_000, r.pairWindowMs());
+        assertEquals(3_000, r.repeatDebounceMs());
+        assertNull(r.error());
+    }
+
+    @Test
+    void aWindowLongEnoughForTheSlowCrossingInTheReportIsAccepted() {
+        // inner 11:50:10.130, outer 11:50:41.823: 31.7 s apart, more than the 15 s default
+        Result r = GatePairingSettings.resolve(15_000, 3_000, 60_000, null);
+        assertTrue(r.ok());
+        assertEquals(60_000, r.pairWindowMs());
+        assertEquals(3_000, r.repeatDebounceMs());
+    }
+
+    @Test
+    void onlyTheRepeatTimeCanBeChangedToo() {
+        Result r = GatePairingSettings.resolve(15_000, 3_000, null, 5_000);
+        assertTrue(r.ok());
+        assertEquals(15_000, r.pairWindowMs());
+        assertEquals(5_000, r.repeatDebounceMs());
+    }
+
+    @Test
+    void theLimitsThemselvesAreAllowed() {
+        assertTrue(GatePairingSettings.resolve(15_000, 3_000, 1_000, 500).ok());
+        assertTrue(GatePairingSettings.resolve(15_000, 3_000, 300_000, 60_000).ok());
+    }
+
+    @Test
+    void aWindowBelowOneSecondOrAboveFiveMinutesIsRejected() {
+        Result tooShort = GatePairingSettings.resolve(15_000, 500, 999, null);
+        assertFalse(tooShort.ok());
+        assertTrue(tooShort.error().contains("between 1 s and 300 s"), tooShort.error());
+        assertTrue(tooShort.error().contains("it was 0.999 s"), tooShort.error());
+
+        Result tooLong = GatePairingSettings.resolve(15_000, 3_000, 300_001, null);
+        assertFalse(tooLong.ok());
+        assertTrue(tooLong.error().contains("pairing window"), tooLong.error());
+    }
+
+    @Test
+    void aRepeatTimeOutsideItsLimitsIsRejected() {
+        assertFalse(GatePairingSettings.resolve(15_000, 3_000, null, 499).ok());
+        Result tooLong = GatePairingSettings.resolve(300_000, 3_000, null, 60_001);
+        assertFalse(tooLong.ok());
+        assertTrue(tooLong.error().contains("repeat-read time"), tooLong.error());
+    }
+
+    @Test
+    void theWindowCannotBeShorterThanTheRepeatTime() {
+        Result r = GatePairingSettings.resolve(15_000, 3_000, 2_000, null);
+        assertFalse(r.ok());
+        assertTrue(r.error().contains("cannot be shorter"), r.error());
+        // a stored repeat time that is longer than a requested window is caught the same way
+        assertFalse(GatePairingSettings.resolve(15_000, 10_000, 5_000, null).ok());
+        // and raising the repeat time above the stored window is too
+        assertFalse(GatePairingSettings.resolve(15_000, 3_000, null, 20_000).ok());
+    }
+
+    @Test
+    void secondsAreWrittenTheWayAPersonReadsThem() {
+        assertEquals("15 s", GatePairingSettings.seconds(15_000));
+        assertEquals("31.693 s", GatePairingSettings.seconds(31_693));
+        assertEquals("0.5 s", GatePairingSettings.seconds(500));
+        assertEquals("300 s", GatePairingSettings.seconds(300_000));
+    }
+}
diff --git a/backend/src/test/java/com/vinabeef/web/ReaderReadFeedTest.java b/backend/src/test/java/com/vinabeef/web/ReaderReadFeedTest.java
new file mode 100644
index 0000000..27677ce
--- /dev/null
+++ b/backend/src/test/java/com/vinabeef/web/ReaderReadFeedTest.java
@@ -0,0 +1,71 @@
+package com.vinabeef.web;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+/**
+ * Text-level checks of the reader page's read feed. The statement was also run against a PostgreSQL 16 database built
+ * from the real migrations, with the cases in the class comment of {@link ReaderReadFeed}.
+ */
+class ReaderReadFeedTest {
+
+    private static final String SQL = ReaderReadFeed.SQL;
+
+    @Test
+    void theGateIdIsBoundTwice() {
+        long placeholders = SQL.chars().filter(c -> c == '?').count();
+        assertEquals(2L, placeholders, "gates.reader_name and gate_readers.gate_id each take the gate id");
+    }
+
+    @Test
+    void theFeedStaysAtTheNewestFiftyReads() {
+        assertEquals(50, ReaderReadFeed.LIMIT);
+        assertTrue(SQL.contains("LIMIT " + ReaderReadFeed.LIMIT), "the limit in the statement must match the constant");
+        // the limit is applied before the joins, so a reader with a long history stays cheap
+        assertTrue(SQL.indexOf("LIMIT 50") < SQL.indexOf("FROM recent r"));
+    }
+
+    @Test
+    void theFirstReadOfACompletedCrossingIsFoundThroughFirstEventId() {
+        // movements.source_event_id is only the LATER read of a pair; the earlier one is movements.first_event_id.
+        // Joining only on source_event_id made that read look like a tag that is not registered.
+        assertTrue(SQL.contains("LEFT JOIN movements m  ON m.source_event_id = r.event_id"));
+        assertTrue(SQL.contains("LEFT JOIN movements fm ON fm.first_event_id = r.event_id"));
+    }
+
+    @Test
+    void anUnpairedReadIsAHalfCrossingNotAnUnregisteredTag() {
+        assertTrue(SQL.contains("LEFT JOIN gate_crossing_candidates cand ON cand.event_id = r.event_id"));
+        assertTrue(SQL.indexOf("THEN 'HALF_CROSSING'") < SQL.indexOf("THEN 'UNREGISTERED_TAG'"),
+                "a read waiting for its partner must be classified before the registered-tag test");
+    }
+
+    @Test
+    void everyOutcomeThePageKnowsIsProduced() {
+        List<String> outcomes = List.of("COPY", "USB_UNMAPPED", "PASSAGE", "CROSSING_FIRST", "HALF_CROSSING",
+                "SYSTEM", "UNREGISTERED_TAG", "NO_MOVEMENT");
+        for (String outcome : outcomes) {
+            assertTrue(SQL.contains("'" + outcome + "'"), outcome);
+        }
+    }
+
+    @Test
+    void theAnimalIsResolvedTheWayTheProcessingServiceDoes() {
+        // the tag's assignment that was active when the read was handled, else the event's user name if a live animal
+        assertTrue(SQL.contains("ta.valid_from <= r.handled_at"));
+        assertTrue(SQL.contains("ta.valid_to IS NULL OR ta.valid_to > r.handled_at"));
+        assertTrue(SQL.contains("a.lifecycle_status <> 'ARCHIVED'"));
+    }
+
+    @Test
+    void theColumnsTheTemplateRendersAreAllReturned() {
+        for (String column : List.of("event_class", "read_source", "source_device", "credential_identifier",
+                "duplicate_of", "movement_id", "animal_id", "direction", "outcome", "half_side", "other_delta_ms")) {
+            assertTrue(SQL.contains(column), column);
+        }
+    }
+}
