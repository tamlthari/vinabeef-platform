# Demo settings for one gateway with a Safetrust USB IoT reader that types numbers like a keyboard.
# No secrets in this file. Load it and start the gateway:
#   Linux / macOS:  set -a; . ./edge.demo.env; set +a; python barn_edge_gateway.py
#   Docker:         docker run --rm -it -p 8090:8090 -v edge-data:/data --env-file edge.demo.env barn-edge     (-it is needed for stdin)
# Then open http://localhost:8090/ (or http://<this computer's IP>:8090/ from a phone on the same network).

# Where events go. The console only shows this link; the gateway is what connects.
CLOUD_BASE_URL=https://api.tamholthucwzr.men/api/v1

# The USB reader. stdin = the reader types into the terminal this gateway runs in: click that terminal, then tap a tag.
# The name on the right is the Safetrust reader the USB reader stands next to. CHANGE IT to the real reader at your gate.
LOCAL_INPUTS=stdin=F9E2
# On Linux you can read the reader itself, without keeping a terminal in focus (find the device with: ls -l /dev/input/by-id/):
# LOCAL_INPUTS=kbd:/dev/input/event5=F9E2

# What each typed number means. The card goes on the swipe, so the cloud reads it as an ordinary card read.
LOCAL_CREDENTIAL_MAP=36=042FAC02AD1490,1005=04B86592C21290,35=04143802F32290,38=044E6602AD1490

# Reader feed (MQTT). OFF in this demo: the USB reader alone is enough to show typed numbers reaching the cloud.
# To also receive the wall readers' own events (and see the console's Reader feed card turn Connected), remove the # and paste the token:
# MQTT_URL=wss://sensor.demo.safetrust.com:443/mqtt
# MQTT_USERNAME=728589
# MQTT_PASSWORD=token/PASTE_THE_SAFETRUST_API_TOKEN_HERE
# MQTT_TOPICS=Web/475/Monitoring/728589
# Unique for every program that connects to this broker, in the shape of the cloud's own (Web_Direct_728589, Web_Standby_728589):
# MQTT_CLIENT_ID=Web_Edge_728589_demo1

EDGE_GATEWAY_NO=1
EDGE_BIND_HOST=0.0.0.0
EDGE_BIND_PORT=8090
# EDGE_CONSOLE_TOKEN=pick-a-password     # without it anyone on the network can open the console
# EDGE_DB_PATH=edge_outbox.db            # where waiting events are kept (Docker keeps them in /data)
