# Barn edge gateway settings. Copy to .env, fill in, and load with:  set -a; . ./.env; set +a
# Never commit the filled-in file: MQTT_PASSWORD contains the Safetrust API token.

# The VinaBeef backend this gateway forwards to (the deployed site, or your local backend when testing)
CLOUD_BASE_URL=https://api.tamholthucwzr.men/api/v1

# --- MQTT source -------------------------------------------------------------------------------------
# Safetrust cloud broker (what the backend and multi_webs_sub_mqtt_threads_2.py use today)
MQTT_URL=wss://sensor.demo.safetrust.com:443/mqtt
MQTT_USERNAME=728589
# Safetrust wants the literal prefix "token/" followed by the API token
MQTT_PASSWORD=token/PASTE_THE_SAFETRUST_API_TOKEN_HERE
MQTT_TOPICS=Web/475/Monitoring/728589
# Every running copy needs its own client id, or the broker disconnects the other one. Keep the Web_ prefix.
MQTT_CLIENT_ID=Web_Edge_barn1
# A broker on the barn LAN would look like:  MQTT_URL=mqtt://192.168.2.10:1883  (no username needed)

# --- optional ----------------------------------------------------------------------------------------
# EDGE_DB_PATH=edge_outbox.db          # keep this on storage that survives a reboot
# EDGE_BIND_HOST=0.0.0.0               # LAN address for the HTTP intake and /status
# EDGE_BIND_PORT=8090
# EDGE_INGEST_TOKEN=change-me          # if set, POST needs the header  X-Edge-Token: change-me
# EDGE_CONSOLE_TOKEN=change-me         # password for the read-only web console (http://<gateway>:8090/). Empty = open to the barn LAN
# MQTT_CLEAN_SESSION=true              # false asks the broker to keep messages while this gateway is off
# MQTT_QOS=1
# MQTT_TLS_INSECURE=true               # the Safetrust demo broker needs this; use false with a real CA
# EDGE_MAX_QUEUE_ROWS=200000

# --- USB readers on this gateway (Safetrust USB IoT) -----------------------------------------------------------
# The USB reader sends only a credential number ("38", "1005"), no time and no card UUID. The gateway stamps the time,
# the cloud finds the card for that number. Leave LOCAL_INPUTS empty to run without USB readers.
#   LOCAL_INPUTS=<kind>:<device>=<Safetrust reader it stands next to>, ...
#     kbd:/dev/input/event5=DrC0F8          keyboard-style reader (the gateway grabs the device exclusively)
#     serial:/dev/ttyACM0@9600=DrC1C4       serial / CDC reader (needs pyserial; @baud optional)
#     stdin=DrC0F8                          demo: type a number and press Enter in the terminal
#   Find the keyboard device with:  ls -l /dev/input/by-id/   (the *-event-kbd entry of the reader)
# LOCAL_INPUTS=kbd:/dev/input/event5=DrC0F8,kbd:/dev/input/event6=DrC1C4
# EDGE_GATEWAY_NO=1                    # 1..99, unique per gateway: keeps the negative EVENT_KEYs of USB swipes apart
# LOCAL_READERS=DrC0F8,DrC1C4          # readers POST /local-swipe may name (the inputs above are added automatically)
# LOCAL_CREDENTIAL_MAP=36=042FAC02AD1490,1005=04B86592C21290,35=04143802F32290,38=044E6602AD1490   # the card UUID of a typed number (demo, or numbers the cloud does not know yet)
# LOCAL_HOLD_MS=6000                   # while MQTT is up, wait this long for the reader's own copy of the tap (0 = never wait)
# LOCAL_MATCH_SKEW_MS=10000            # same tap = closer than this, on the reader's clock AND the gateway's
# LOCAL_IDLE_FLUSH_MS=200              # a USB device that sends no Enter ends a swipe after this silence
# LOCAL_LOG_RETENTION_S=86400          # how long the swipe log is kept
# LOCAL_COMPANY_KEY=475                # optional COMPANY_KEY copied onto USB swipes
# LOCAL_GRAB_KEYBOARD=true             # false only for testing: digits would ALSO be typed into the gateway's console
