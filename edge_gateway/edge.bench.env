# Test bench: the gateway against a fake backend and a local MQTT broker, so nothing reaches the real cloud or the Safetrust broker.
# Steps are in RUN-AND-TEST.md (section "Test bench"). From edge_gateway/, in three terminals:
#   1)  echo ok > /tmp/bench.mode; : > /tmp/bench.accepted; python drill/fake_backend.py 18080 /tmp/bench.mode /tmp/bench.accepted
#   2)  pip install amqtt; python drill/broker.py 1883                    (optional: only needed for the reader feed and the pairing test)
#   3)  set -a; . ./edge.bench.env; set +a; python barn_edge_gateway.py   then open http://localhost:8090/
# What the fake backend does is chosen by what is in /tmp/bench.mode:  ok | down503 (health fails: Degraded) | hang (no answer: Offline)
#   | health_ok_write_503 (health passes, writes fail). Stop it with Ctrl-C to see Offline; start it again to see the backlog drain.

CLOUD_BASE_URL=http://127.0.0.1:18080/api/v1

# The reader feed: a broker on this computer standing in for Safetrust. Remove these four lines to run without it.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPICS=Web/475/Monitoring/728589
MQTT_CLIENT_ID=Web_Edge_bench

# A USB reader that types numbers: you play it by typing a number and Enter in this terminal. DrC0F8 is the reader it stands next to.
LOCAL_INPUTS=stdin=F9E2
LOCAL_CREDENTIAL_MAP=36=042FAC02AD1490,1005=04B86592C21290,35=04143802F32290,38=044E6602AD1490

EDGE_GATEWAY_NO=1
EDGE_BIND_HOST=127.0.0.1
EDGE_BIND_PORT=8090
EDGE_DB_PATH=./bench_outbox.db
# Retry at most every 10 s, so a recovery shows quickly (the default is 60 s):
EDGE_BACKOFF_MAX=10
