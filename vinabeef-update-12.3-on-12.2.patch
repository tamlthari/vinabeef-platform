diff --git a/frontend/templates/partials/transmission_detail.html b/frontend/templates/partials/transmission_detail.html
index 367203c..7fdcc28 100644
--- a/frontend/templates/partials/transmission_detail.html
+++ b/frontend/templates/partials/transmission_detail.html
@@ -1,3 +1,95 @@
-{# Content of the window opened from a row of the transmission log. Everything
-from the backend is autoescaped; the body is placed in
-<pre>>
+{# The window opened from a row of the transmission log: what was sent and what came back.
+   Everything that comes from the backend is autoescaped (the body is placed in <pre> as text, never as markup).
+   The page script in surveillance.html wires these hooks: data-tx-close, data-tx-view="pretty|raw",
+   #tx-pre-pretty / #tx-pre-raw, data-tx-copy (copies the body that is showing) and data-tx-copy-text (copies the value it holds).
+   Context: d (the backend's answer, or None), view (build_transmission_view(d), or None), tx_id, error. #}
+<div class="p-6">
+  <div class="flex items-start justify-between gap-4">
+    <div class="min-w-0">
+      <h3 class="text-sm font-bold text-gray-900">Transmission <span class="font-mono">{{ tx_id }}</span></h3>
+      {% if d %}
+      <p class="mt-1 text-[11px] text-gray-500">{{ d.reportType }} ({{ d.farmScope }}) &middot; {{ d.recordCount }} rows &middot; sent by {{ d.transmittedBy or 'unknown' }} at {{ d.transmittedAt | localtime }}</p>
+      {% endif %}
+    </div>
+    <button type="button" data-tx-close class="shrink-0 px-3 py-1.5 rounded-md border border-gray-300 text-xs font-semibold text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-300">Close</button>
+  </div>
+
+  {% if error or not d %}
+  <p class="mt-5 text-xs text-rose-700" role="alert">{{ error or 'The transmission could not be loaded.' }}</p>
+  {% else %}
+
