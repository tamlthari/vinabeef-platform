+def render(**kw):
+    env = main.templates.env
+    d, error = kw.get("d"), kw.get("error", "")
+    return env.get_template("partials/transmission_detail.html").render(
+        d=d, view=main.build_transmission_view(d) if d else None, tx_id="TX-1001", error=error)
